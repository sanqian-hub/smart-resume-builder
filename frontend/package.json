{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest --reporter=verbose",
    "test:run": "vitest run --reporter=verbose",
    "test:e2e": "start-server-and-test \"npm run dev -- --host 127.0.0.1 --port 4173 --strictPort\" http://127.0.0.1:4173 \"playwright test\"",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "verify": "npm run test:run && npm run test:e2e && npm run build"
  },
  "dependencies": {
    "axios": "^1.15.2",
    "html2canvas": "^1.4.1",
    "html2pdf.js": "^0.14.0",
    "jspdf": "^4.2.1",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.32",
    "vue-advanced-cropper": "^2.8.9",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/vue": "^8.1.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^27.0.1",
    "start-server-and-test": "^2.1.2",
    "vite": "^8.0.10",
    "vitest": "^3.2.4"
  }
}
